# OpenMU Browser Stack Configuration

# WebSocket Proxy
WS_PORT=7100
WS_HOST=0.0.0.0

# Web Server (serves WASM client)
WEB_PORT=8080
WEB_HOST=0.0.0.0

# OpenMU Connect Server (initial connection)
MU_CONNECT_HOST=127.0.0.1
MU_CONNECT_PORT=44405

# OpenMU Game Server host (used for IP remapping in ConnectionInfo packets)
MU_GAME_HOST=127.0.0.1

# Proxy public address (what the WASM client connects to)
#
# This is written into the ConnectionInfo packet (C1 16 F4 03) that the connect
# server sends, after the proxy rewrites it. Point it at the PUBLIC WebSocket
# entry point (the same origin the page is served from) - never at the origin
# IP:port, which would advertise an address that bypasses nginx/Cloudflare and
# has no TLS.
#
# The WASM client currently ignores this field entirely and always reconnects to
# the URL on the page, so a wrong value will not break browsing today - it only
# leaks the origin and breaks the moment that behaviour changes.
PROXY_PUBLIC_HOST=127.0.0.1
PROXY_PUBLIC_PORT=7100

# Game-server redirect handling.
#
# The client cannot send a session token (its WebSocket URL is fixed and cached),
# so a ConnectionInfo redirect is matched to the next connection from the same
# client. SESSION_TTL_MS bounds how long an unused redirect stays armed - it
# mainly stops a player who never reconnects from hijacking the next connection.
# The client reconnects within milliseconds, so this can stay generous.
SESSION_TTL_MS=30000

# Redirects queued per client before the oldest is dropped. More than one is
# needed when several players share a public IP (same NAT).
MAX_TARGETS_PER_KEY=8
